{
    "version": 1,
    "tokens": {
        "layout.columns": { "var": "--wpc-rf-cols", "kind": "int", "unit": "", "min": 1, "max": 3 },
        "layout.row_gap": { "var": "--wpc-rf-row-gap", "kind": "int", "unit": "px", "min": 0, "max": 64 },
        "layout.column_gap": { "var": "--wpc-rf-col-gap", "kind": "int", "unit": "px", "min": 0, "max": 64 },

        "input.height": { "var": "--wpc-rf-input-height", "kind": "int", "unit": "px", "min": 32, "max": 64 },
        "input.radius": { "var": "--wpc-rf-input-radius", "kind": "int", "unit": "px", "min": 0, "max": 40 },
        "input.border_width": { "var": "--wpc-rf-input-border-width", "kind": "int", "unit": "px", "min": 0, "max": 4 },
        "input.bg": { "var": "--wpc-rf-input-bg", "kind": "color" },
        "input.text": { "var": "--wpc-rf-input-text", "kind": "color" },
        "input.border": { "var": "--wpc-rf-input-border", "kind": "color" },
        "input.focus": { "var": "--wpc-rf-input-focus", "kind": "color" },
        "input.placeholder": { "var": "--wpc-rf-input-placeholder", "kind": "color" },

        "label.color": { "var": "--wpc-rf-label-color", "kind": "color" },
        "label.size": { "var": "--wpc-rf-label-size", "kind": "int", "unit": "px", "min": 12, "max": 22 },
        "label.weight": { "var": "--wpc-rf-label-weight", "kind": "int", "unit": "", "min": 300, "max": 800, "step": 100 },
        "label.gap": { "var": "--wpc-rf-label-gap", "kind": "int", "unit": "px", "min": 0, "max": 24 },

        "button.bg": { "var": "--wpc-rf-btn-bg", "kind": "color" },
        "button.text": { "var": "--wpc-rf-btn-text", "kind": "color" },
        "button.hover_bg": { "var": "--wpc-rf-btn-hover-bg", "kind": "color" },
        "button.hover_text": { "var": "--wpc-rf-btn-hover-text", "kind": "color" },
        "button.radius": { "var": "--wpc-rf-btn-radius", "kind": "int", "unit": "px", "min": 0, "max": 40 },
        "button.height": { "var": "--wpc-rf-btn-height", "kind": "int", "unit": "px", "min": 32, "max": 64 },
        "button.full_width": { "flag": "btn-full", "kind": "bool" },

        "container.bg": { "var": "--wpc-rf-card-bg", "kind": "color" },
        "container.border": { "var": "--wpc-rf-card-border", "kind": "color" },
        "container.radius": { "var": "--wpc-rf-card-radius", "kind": "int", "unit": "px", "min": 0, "max": 40 },
        "container.padding": { "var": "--wpc-rf-card-padding", "kind": "int", "unit": "px", "min": 0, "max": 64 }
    }
}
